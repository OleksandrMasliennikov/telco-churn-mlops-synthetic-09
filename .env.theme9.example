# .env.theme9
# Налаштування для Теми 9
# Скопіювати у .env.theme9 та заповнити реальні значення
# НЕ комітити у git (вже додано до .gitignore)

# ── ОБЕРИ ОДНОГО LLM-ПРОВАЙДЕРА (без OpenAI-акаунту) ──────────────
# anthropic → потрібен ANTHROPIC_API_KEY (платно, дуже дешево, ~$0.15 на всі лаби)
# gemini    → потрібен GOOGLE_API_KEY    (БЕЗКОШТОВНО: aistudio.google.com/apikey)
# groq      → потрібен GROQ_API_KEY      (БЕЗКОШТОВНО: console.groq.com, дуже швидко)
# ollama    → ключ НЕ потрібен взагалі   (100% офлайн, для аудиторії без інтернету)
LLM_PROVIDER=gemini

# ── Ключі (заповни ТІЛЬКИ той, що відповідає LLM_PROVIDER вище) ──
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
# ollama ключа не має — див. блок OLLAMA нижче

# ── Моделі (можна залишити дефолтні) ──────────────────────────────
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile

# ── OLLAMA (LLM_PROVIDER=ollama) — повністю офлайн, без ключа ────
# Модель треба завантажити ЗАЗДАЛЕГІДЬ (потрібен інтернет один раз):
#   make -f Makefile.theme9 ollama-pull
# OLLAMA_BASE_URL="http://ollama:11434" — це ім'я сервіса в Docker-мережі
# mlops-net (docker-compose.theme9.yml), НЕ localhost.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Rate limiting (щоб не впиратись у 429 на безкоштовних тарифах) ──
# LLM_RPM_LIMIT — запитів/хвилину, які llm_client.py дозволяє собі
# робити (throttle перед кожним викликом). Дефолти вже підібрані під
# реальні безкоштовні ліміти (gemini=15, groq=28, anthropic=50) — змінюй
# лише якщо твій тариф інший.
# RAGAS_MAX_WORKERS — паралельність RAGAS evaluate() (дефолт: gemini=1,
# groq=2, anthropic=4) — знижена намисно, бо 429 частіше стається саме
# через паралельні запити, а не через сумарну швидкість.
# LLM_REQUEST_TIMEOUT — секунд на ОДИН HTTP-запит до LLM (усі провайдери).
# Без цього зависла мережа могла "заморозити" прогрес-бар на 0%
# нескінченно — жоден retry навіть не почнеться, поки запит формально
# не завершиться помилкою.
LLM_RPM_LIMIT=
RAGAS_MAX_WORKERS=
LLM_REQUEST_TIMEOUT=

# ── Локальні embeddings для RAGAS (метрика answer_relevancy) ───────
# huggingface → локальна sentence-transformers модель, БЕЗ ключа,
#               ваги вшиті в Docker-образ під час build (завжди офлайн)
# ollama      → embeddings теж через локальний сервіс ollama
#               (використай, якщо LLM_PROVIDER=ollama і хочеш повністю
#               уникнути sentence-transformers у образі)
EMBEDDING_BACKEND=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── LangSmith (опційно, безкоштовний акаунт: smith.langchain.com) ─
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=churn-ai-demo

# ── MLflow ────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Lab налаштування ─────────────────────────────────────────────
COST_FP=10
COST_FN=300
BASELINE_F1=0.72
F1_THRESHOLD=0.05
RAGAS_THRESHOLD=0.85
N_EVAL_SAMPLES=50
N_JUDGE_SAMPLES=20
CORR_THRESHOLD=0.75
DEMO_DRIFT=false

# ── Застаріле (більше не використовується, залишено для сумісності) ──
# OPENAI_API_KEY=
